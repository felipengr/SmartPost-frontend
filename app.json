{
  "expo": {
    "name": "Smart Poste",
    "slug": "smart-poste",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-smartposte.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.felipengr.smartposte",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icon-smartposte.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icon-smartposte.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Permita que o $(PRODUCT_NAME) acesse sua câmera para fotografar postes e fios danificados.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o $(PRODUCT_NAME) use sua localização para mostrar a distância das ocorrências e registrar onde está o problema.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "scheme": "smartposte",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bdd5003b-3736-4fca-8826-c5fd852a8976"
      }
    }
  }
}
